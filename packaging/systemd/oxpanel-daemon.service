# OxPanel system engine.
#
# The daemon must run as root: it creates accounts, writes under /etc/nginx and
# /etc/systemd, and manages SELinux labels. Everything below narrows what that
# root can do. Keep the ReadWritePaths list minimal and justified.

[Unit]
Description=OxPanel system engine
Documentation=https://github.com/OxServers/oxpanel
After=network.target nginx.service systemd-sysusers.service
Wants=nginx.service

[Service]
Type=notify
ExecStart=/usr/sbin/oxpanel-daemon
EnvironmentFile=-/etc/oxpanel/daemon.env
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s
User=root
Group=root
UMask=0077

# Directories systemd creates and owns for us.
RuntimeDirectory=oxpanel
RuntimeDirectoryMode=0755
StateDirectory=oxpanel
StateDirectoryMode=0700
ConfigurationDirectory=oxpanel
ConfigurationDirectoryMode=0750

# --- Isolation ---------------------------------------------------------------
# No network traffic: the API is a UNIX socket and every tool we call is local.
# AF_INET/AF_INET6 stay *creatable* because `nginx -t` opens (never binds or
# connects) an INET socket to validate `listen` directives; IPAddressDeny=any
# and PrivateNetwork=yes make sure nothing can actually be reached.
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectSystem=strict
# /etc:      useradd/userdel/gpasswd/usermod/chpasswd rewrite passwd/shadow/group via rename
#            (chpasswd gets SFTP passwords on stdin, never in argv); nginx and systemd
#            unit files (including the mount units of SFTP chroots); the sshd drop-in and the
#            tenants' SFTP keys files (/etc/oxpanel-sftp). `sshd -t`/`-T` only read /etc/ssh.
#            xfs_quota needs the block device, which PrivateDevices hides: it runs in a
#            transient unit (systemd-run) and writes its report to /run/oxpanel/scratch.
# /home:     tenant homes
# /var/lib:  nginx -t temp dirs (/var/lib/nginx), the semanage policy store (/var/lib/selinux),
#            the sssd cache (/var/lib/sss). Listed as the parent on purpose: /var/lib/selinux is
#            labelled semanage_store_t, a SELinux *security* file type, and the targeted policy
#            forbids init_t from mounting on it, so naming it directly makes the unit fail with
#            "Failed at step NAMESPACE" on every enforcing host (found by make acceptance).
# /var/log/nginx: `nginx -t` opens the configured error_log for writing even in test mode.
# HTTPS needs no further entries: certificates and keys go to /etc/pki/oxpanel (under /etc),
# ACME signing requests and issued chains to /var/lib/oxpanel-acme (under /var/lib). The ACME
# client itself never runs in this unit (PrivateNetwork=yes) but in a transient unit started
# with systemd-run, as the unprivileged account oxpanel-acme.
ReadWritePaths=/etc /home /var/lib /var/log/nginx
ProtectHome=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
RemoveIPC=yes
NoNewPrivileges=yes

# --- Capabilities --------------------------------------------------------------
# Deny-list: everything the daemon and the tools it execs can never need.
# (An allow-list is the goal; useradd, setfacl, restorecon and semanage each
# need a different, poorly documented subset, so the deny-list is what we can
# state with confidence today.)
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_RAWIO CAP_SYS_BOOT CAP_SYS_TIME CAP_SYS_PTRACE
# CAP_NET_BIND_SERVICE stays: `nginx -t` binds the configured listen sockets
# (tolerating EADDRINUSE) as part of validation, so it must be *able* to bind :80.
CapabilityBoundingSet=~CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BROADCAST
CapabilityBoundingSet=~CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_AUDIT_WRITE CAP_SYSLOG
CapabilityBoundingSet=~CAP_MKNOD CAP_LINUX_IMMUTABLE CAP_IPC_LOCK CAP_IPC_OWNER
CapabilityBoundingSet=~CAP_BLOCK_SUSPEND CAP_WAKE_ALARM CAP_LEASE CAP_BPF CAP_PERFMON
CapabilityBoundingSet=~CAP_SYS_TTY_CONFIG CAP_SYS_PACCT CAP_SYS_NICE CAP_SYS_RESOURCE CAP_MAC_OVERRIDE

# --- System calls --------------------------------------------------------------
SystemCallArchitectures=native
# @system-service plus what setpriv (capset) needs to drop privileges for tenant commands.
SystemCallFilter=@system-service capset
SystemCallFilter=~@debug @mount @cpu-emulation @obsolete @reboot @swap @module @raw-io
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
