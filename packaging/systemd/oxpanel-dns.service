# OxPanel's authoritative DNS server: BIND (the bind package from AppStream)
# with the configuration OxPanel renders in /etc/named/oxpanel. It is never
# started by the package: oxpanel-daemon enables and starts it once DNS
# hosting is switched on (OXPANEL_DNS=true) and the configuration exists.
#
# The distribution's named.service and /etc/named.conf are not used and not
# touched; do not run named.service beside this unit (both want port 53 and
# the control port 953 on the loopback). GetHostInfo warns if it runs.
#
# named starts as root, reads its configuration (root:named 0640), binds
# port 53 and drops to the named account (-u named), keeping only the
# capabilities below; under SELinux it runs in the packaged named_t domain.

[Unit]
Description=OxPanel authoritative DNS server (BIND)
Documentation=https://github.com/OxServers/oxpanel
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/named/oxpanel/named.conf

[Service]
Type=simple
ExecStartPre=/usr/sbin/named-checkconf /etc/named/oxpanel/named.conf
ExecStart=/usr/sbin/named -f -u named -c /etc/named/oxpanel/named.conf
# Load new zones and drop removed ones; changed zones are reloaded one by
# one by the daemon (rndc reload <zone>).
ExecReload=/usr/sbin/rndc -c /etc/named/oxpanel/rndc.conf reconfig
Restart=on-failure
RestartSec=2s
TimeoutStopSec=30s

# --- Isolation ---------------------------------------------------------------
# Writable: zone files' signed copies and journals, signing keys, the working
# directory. Everything else is read-only; homes are invisible.
ProtectSystem=strict
ReadWritePaths=-/var/lib/oxpanel-dns
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK: named watches the interface list for addresses to listen on.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# What named keeps when it drops to its account (BIND's own list): binding
# port 53, changing identity, raising its file-descriptor limit, and reading
# and owning its files on the way. CAP_DAC_OVERRIDE: before it drops to its
# account, named (and named-checkconf in ExecStartPre) runs as root and must
# enter its own directories (named 0700), as the packaged named.service lets
# it; named does not keep it after the drop.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_SYS_RESOURCE CAP_CHOWN CAP_DAC_READ_SEARCH CAP_SYS_CHROOT
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
