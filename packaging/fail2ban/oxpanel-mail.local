# OxPanel (email): ban addresses that keep failing to log in to a mailbox
# over IMAPS/POP3S (Dovecot), SMTP submission (Postfix's SASL) or webmail
# (Roundcube). Installed by install.sh --mail when login banning is on.
# The loopback is never banned: webmail logs in to Dovecot from 127.0.0.1,
# and its own jail bans the browser's address instead.

[DEFAULT]
ignoreip = 127.0.0.1/8 ::1

[dovecot]
enabled  = true
backend  = systemd
port     = imaps,pop3s
maxretry = 5
findtime = 10m
bantime  = 1h

[postfix-sasl]
enabled  = true
backend  = systemd
port     = submission,submissions
maxretry = 5
findtime = 10m
bantime  = 1h

[oxpanel-webmail]
enabled  = true
backend  = systemd
journalmatch = SYSLOG_IDENTIFIER=oxpanel-webmail
filter   = oxpanel-webmail
port     = http,https
maxretry = 5
findtime = 10m
bantime  = 1h
