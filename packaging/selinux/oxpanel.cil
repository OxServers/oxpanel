; OxPanel SELinux policy module (CIL; no compiler needed):
;   semodule -i /usr/share/oxpanel/selinux/oxpanel.cil
;
; Tenant applications (Node.js, Python) run in their own domain,
; oxpanel_app_t, so that the one thing the web server needs — connecting to
; an application's UNIX socket — can be allowed for exactly those processes
; and for nothing else on the host.
;
; Within that domain SELinux does not restrict ordinary file and network
; access: an application is confined by running as its tenant (file
; ownership), by its systemd sandbox and by the tenant's cgroup limits. It is
; nevertheless narrower than the stock unconfined service domain it would
; otherwise run in (see the attribute list). A confining policy is a roadmap item.

(type oxpanel_app_t)
(roletype system_r oxpanel_app_t)
(typeattributeset domain (oxpanel_app_t))
; The attributes of the stock unconfined service domain that an ordinary
; program needs (files, network, devices, file systems, kernel interfaces).
; Deliberately left out: loading policy or kernel modules, changing booleans
; or enforcement, raw storage, relabelling to shadow or policy types, and
; unconfined D-Bus access.
(typeattributeset unconfined_domain_type (oxpanel_app_t))
(typeattributeset files_unconfined_type (oxpanel_app_t))
(typeattributeset corenet_unconfined_type (oxpanel_app_t))
(typeattributeset devices_unconfined_type (oxpanel_app_t))
(typeattributeset filesystem_unconfined_type (oxpanel_app_t))
(typeattributeset kern_unconfined (oxpanel_app_t))
(typeattributeset process_uncond_exempt (oxpanel_app_t))

; systemd starts an application in this domain (SELinuxContext= in its unit);
; the interpreters (node, python) are ordinary bin_t programs.
(allow init_t oxpanel_app_t (process (transition)))
; The units set NoNewPrivileges=yes; a domain transition under it needs this.
(allow init_t oxpanel_app_t (process2 (nnp_transition nosuid_transition)))
(allow oxpanel_app_t bin_t (file (entrypoint)))
; Just-in-time compilers (V8 in Node.js) need writable-executable memory.
(allow oxpanel_app_t self (process (execmem)))

; The web server may connect to application sockets, and only to those.
(allow httpd_t oxpanel_app_t (unix_stream_socket (connectto)))

; ACME HTTP-01 challenge tokens: written by the ACME client, served by the web
; server under /.well-known/acme-challenge/ of every site. Labelled as ordinary
; web content (read-only for httpd_t); the rest of /var/lib/oxpanel-acme stays
; var_lib_t, which the web server cannot read.
(filecon "/var/lib/oxpanel-acme/challenges(/.*)?" any (system_u object_r httpd_sys_content_t ((s0) (s0))))

; Runtime directories of applications: sockets created inside inherit the
; type, which the web server is allowed to write to.
(filecon "/var/run/oxpanel-app(/.*)?" any (system_u object_r httpd_var_run_t ((s0) (s0))))

; SFTP passwords: the daemon (unconfined_service_t, NoNewPrivileges=yes)
; runs chpasswd, which the stock policy moves into passwd_t. Under
; NoNewPrivileges that transition needs nnp_transition; without it the
; kernel refuses the transition, logs a denial and runs chpasswd in the
; daemon's own, unconfined domain. Allowing it runs chpasswd confined, as
; it would be without NoNewPrivileges. Nothing else may enter passwd_t this way.
(allow unconfined_service_t passwd_t (process2 (nnp_transition)))

; DNS hosting: OxPanel's BIND instance (oxpanel-dns.service, the packaged
; named_t domain) writes the signed copies and journals of zones next to the
; zone files, its signing keys and its working files under
; /var/lib/oxpanel-dns: the type the stock policy gives the server's own
; writable directories (/var/named/dynamic, /var/named/data). Its
; configuration in /etc/named/oxpanel is named_conf_t by the stock rule for
; /etc/named.
(filecon "/var/lib/oxpanel-dns(/.*)?" any (system_u object_r named_cache_t ((s0) (s0))))
