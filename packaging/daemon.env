# /etc/oxpanel/daemon.env — oxpanel-daemon configuration.
# Every value is optional; the defaults shown are what the daemon uses if a
# line is absent. Restart the service after editing.

# UNIX socket the gRPC API listens on. The parent directory is created by
# systemd (RuntimeDirectory=oxpanel).
#OXPANEL_SOCKET_PATH=/run/oxpanel/oxpanel.sock

# Group that owns the socket (mode 0660). Members of this group — and any
# peer whose effective or supplementary gid is in OXPANEL_ALLOWED_GIDS — may
# call the API. Empty = socket is root-only (0600).
#OXPANEL_SOCKET_GROUP=oxpanel

# Explicit peer allow-lists (comma-separated numeric ids). The panel-api
# service account should be here or in the socket group.
#OXPANEL_ALLOWED_UIDS=
#OXPANEL_ALLOWED_GIDS=

# Whether a peer running as uid 0 may call the API regardless of the lists.
#OXPANEL_ALLOW_ROOT_PEER=true

# Confine individual peers to parts of the API: uid:scope+scope,uid:scope.
# Scopes: read (get/list/usage/host info/reconcile), vhost (configure/remove
# virtual hosts and their certificates), tenant (create/update/suspend/resume), delete (DeleteTenant),
# all. A uid that is not listed may call everything. Example: let the
# customer-facing tier (uid 993) read and manage sites, nothing else:
#   OXPANEL_PEER_SCOPES=993:read+vhost
#OXPANEL_PEER_SCOPES=

# Inclusive UID range tenants are allocated from (each tenant also gets a
# primary group with the same numeric id when free). Must be >= 1000.
#OXPANEL_UID_MIN=20000
#OXPANEL_UID_MAX=29999

# Where tenant homes live: <OXPANEL_HOME_BASE>/<username>, mode 0700.
#OXPANEL_HOME_BASE=/home

# Daemon state (records of what OxPanel owns). Created by systemd (StateDirectory).
#OXPANEL_STATE_DIR=/var/lib/oxpanel

# Nginx: one <domain>.conf per virtual host in this directory, pulled in by the include file.
#OXPANEL_NGINX_CONF_DIR=/etc/nginx/oxpanel.d
#OXPANEL_NGINX_INCLUDE_FILE=/etc/nginx/conf.d/00-oxpanel.conf

# Install a catch-all `default_server` (return 444) so requests for unknown host
# names or the bare IP never land on a tenant's site. Disable only if the host
# already defines its own default_server.
#OXPANEL_NGINX_DEFAULT_SERVER=true

# Where tenant slice units and user-slice drop-ins are written.
#OXPANEL_SYSTEMD_UNIT_DIR=/etc/systemd/system

# Per-virtual-host access and error logs: <domain>.access.log, <domain>.error.log.
# Rotated by /etc/logrotate.d/oxpanel (keep the two in step if you change this).
#OXPANEL_NGINX_LOG_DIR=/var/log/nginx/oxpanel

# One PHP-FPM pool configuration per tenant that uses PHP (world-readable, no secrets).
#OXPANEL_PHP_CONF_DIR=/etc/oxpanel-php

# Account the web-server workers run as; granted traverse/read on document roots via ACLs.
#OXPANEL_WEB_USER=nginx

# Group every tenant account is put in (created by the package). OxPanel's sshd
# drop-in applies to its members only: SFTP only, chrooted, keys from below.
#OXPANEL_TENANT_GROUP=oxpanel-tenants

# The sshd configuration drop-in OxPanel owns. Its directory must already be
# included by /etc/ssh/sshd_config (AlmaLinux 9 does this by default).
#OXPANEL_SSHD_DROPIN_FILE=/etc/ssh/sshd_config.d/60-oxpanel.conf

# One authorized-keys file per tenant with SFTP access, outside the tenant's
# reach (root-owned; each tenant may only read its own).
#OXPANEL_SFTP_KEYS_DIR=/etc/oxpanel-sftp

# SFTP passwords: allowed (opt-in per tenant, set through the API) unless this
# is false. false = keys only: setting a password is refused and sshd offers
# no tenant password login. Tenants with a password are in the group below.
#OXPANEL_SFTP_PASSWORDS=true
#OXPANEL_SFTP_PASSWORD_GROUP=oxpanel-sftp-password

# Upper bound for any single external command (useradd, nginx -t, ...).
#OXPANEL_COMMAND_TIMEOUT_SECS=60

# tracing filter, e.g. info, debug, oxpanel_daemon=trace
#OXPANEL_LOG=info

# --- HTTPS ---------------------------------------------------------------------
# Certificates (<domain>.crt) and private keys (<domain>.key, 0600) of virtual hosts.
#OXPANEL_TLS_DIR=/etc/pki/oxpanel

# ACME (Let's Encrypt, HTTP-01). The daemon itself has no network: the client
# /usr/libexec/oxpanel/oxpanel-acme runs in a transient unit as `oxpanel-acme`.
# Its working directories (created by tmpfiles.d/oxpanel.conf and labelled by the
# SELinux module; keep both in step if you change this):
#OXPANEL_ACME_DIR=/var/lib/oxpanel-acme
# Directory URL of the certificate authority. Let's Encrypt staging, for trials:
#   https://acme-staging-v02.api.letsencrypt.org/directory
#OXPANEL_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# PEM bundle the client trusts for the authority's own HTTPS (a private or test
# CA); default: the system trust store. Must be readable by `oxpanel-acme` and
# outside /home and /root (the client's unit cannot see those).
#OXPANEL_ACME_CA_FILE=
# Contact address for the ACME account (expiry notices from the authority).
#OXPANEL_ACME_EMAIL=
# External Account Binding, for authorities that require one (ZeroSSL, Google
# Trust Services): a file owned by root, mode 0600, with two lines
#   kid=<key id from the provider>
#   hmac_key=<HMAC key from the provider, base64url>
# It reaches the ACME client as a systemd credential, never on a command line.
#OXPANEL_ACME_EAB_FILE=
# Automatic HTTPS: every site gets (and keeps) a certificate by itself, after a
# local reachability check so names that cannot validate never reach the
# authority. Sites can opt out one by one (oxpanel-ctl vhost set --no-auto-https).
#OXPANEL_AUTO_HTTPS=true
# Renew ACME certificates this many days before they expire (1-60). The daemon
# checks 5 minutes after start and then every 12 hours.
#OXPANEL_ACME_RENEW_DAYS=30
