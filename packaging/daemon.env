# /etc/oxpanel/daemon.env — oxpanel-daemon configuration.
# Every value is optional; the defaults shown are what the daemon uses if a
# line is absent. Restart the service after editing.

# UNIX socket the gRPC API listens on. The parent directory is created by
# systemd (RuntimeDirectory=oxpanel).
#OXPANEL_SOCKET_PATH=/run/oxpanel/oxpanel.sock

# Group that owns the socket (mode 0660). Members of this group — and any
# peer whose effective or supplementary gid is in OXPANEL_ALLOWED_GIDS — may
# call the API. Empty = socket is root-only (0600).
#OXPANEL_SOCKET_GROUP=oxpanel

# Explicit peer allow-lists (comma-separated numeric ids). The panel-api
# service account should be here or in the socket group.
#OXPANEL_ALLOWED_UIDS=
#OXPANEL_ALLOWED_GIDS=

# Whether a peer running as uid 0 may call the API regardless of the lists.
#OXPANEL_ALLOW_ROOT_PEER=true

# Confine individual peers to parts of the API: uid:scope+scope,uid:scope.
# Scopes: read (get/list/usage/host info/reconcile), vhost (configure/remove
# virtual hosts), tenant (create/update/suspend/resume), delete (DeleteTenant),
# all. A uid that is not listed may call everything. Example: let the
# customer-facing tier (uid 993) read and manage sites, nothing else:
#   OXPANEL_PEER_SCOPES=993:read+vhost
#OXPANEL_PEER_SCOPES=

# Inclusive UID range tenants are allocated from (each tenant also gets a
# primary group with the same numeric id when free). Must be >= 1000.
#OXPANEL_UID_MIN=20000
#OXPANEL_UID_MAX=29999

# Where tenant homes live: <OXPANEL_HOME_BASE>/<username>, mode 0700.
#OXPANEL_HOME_BASE=/home

# Daemon state (records of what OxPanel owns). Created by systemd (StateDirectory).
#OXPANEL_STATE_DIR=/var/lib/oxpanel

# Nginx: one <domain>.conf per virtual host in this directory, pulled in by the include file.
#OXPANEL_NGINX_CONF_DIR=/etc/nginx/oxpanel.d
#OXPANEL_NGINX_INCLUDE_FILE=/etc/nginx/conf.d/00-oxpanel.conf

# Install a catch-all `default_server` (return 444) so requests for unknown host
# names or the bare IP never land on a tenant's site. Disable only if the host
# already defines its own default_server.
#OXPANEL_NGINX_DEFAULT_SERVER=true

# Where tenant slice units and user-slice drop-ins are written.
#OXPANEL_SYSTEMD_UNIT_DIR=/etc/systemd/system

# Per-virtual-host access and error logs: <domain>.access.log, <domain>.error.log.
# Rotated by /etc/logrotate.d/oxpanel (keep the two in step if you change this).
#OXPANEL_NGINX_LOG_DIR=/var/log/nginx/oxpanel

# One PHP-FPM pool configuration per tenant that uses PHP (world-readable, no secrets).
#OXPANEL_PHP_CONF_DIR=/etc/oxpanel-php

# Account the web-server workers run as; granted traverse/read on document roots via ACLs.
#OXPANEL_WEB_USER=nginx

# Upper bound for any single external command (useradd, nginx -t, ...).
#OXPANEL_COMMAND_TIMEOUT_SECS=60

# tracing filter, e.g. info, debug, oxpanel_daemon=trace
#OXPANEL_LOG=info
